<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<style>
    /* Suas regras CSS originais mantidas intactas */
    .linha-tabela:nth-child(even) {
        background-color: #f8fafc !important;
    }
    .linha-tabela:nth-child(odd) {
        background-color: #ffffff !important;
    }

    /* Adicionada a blindagem de responsividade apenas via classes externas */
    .container-responsivo-clientes {
        background-color: #ffffff; 
        border: 1px solid #e2e8f0; 
        border-radius: 16px; 
        padding: 2rem; 
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); 
        max-width: 1100px; 
        margin: 0 auto;
        box-sizing: border-box;
        width: 100%;
    }

    .cabecalho-listagem-clientes {
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 2rem; 
        border-bottom: 1px solid #f1f5f9; 
        padding-bottom: 1.5rem;
    }

    /* Regras de quebra de tela apenas para o celular */
    @media (max-width: 640px) {
        .container-responsivo-clientes {
            padding: 1rem; /* Otimiza o espaço interno nas laterais do smartphone */
        }
        
        .cabecalho-listagem-clientes {
            flex-direction: column; /* Empilha o título e o botão verticalmente */
            align-items: flex-start; /* Alinha tudo à esquerda */
            gap: 1rem; /* Distância confortável entre o texto e o botão */
        }

        .cabecalho-listagem-clientes a {
            width: 100%; /* Botão ocupa toda a largura no celular para facilitar o toque */
            justify-content: center;
            box-sizing: border-box;
        }
    }
</style>

<div class="container-responsivo-clientes">
    
    <!-- Cabecalho da Listagem Adaptável -->
    <div class="cabecalho-listagem-clientes">
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; letter-spacing: -0.025em;">Clientes</h2>
            <p style="font-size: 0.875rem; color: #64748b; margin: 5px 0 0 0;">Lista de clientes cadastrados no sistema.</p>
        </div>
        <a href="/clientes/cadastro" style="display: inline-flex; align-items: center; gap: 8px; background-color: #4f46e5; color: #ffffff; text-decoration: none; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);">
            ➕ Novo Cliente
        </a>
    </div>

    <!-- Tabela Estruturada com Rolagem segura ativada (min-width garante leitura perfeita no celular) -->
    <div style="width: 100%; overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 12px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; min-width: 750px;">
            <thead>
                <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; width: 100px;">ID</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">Nome</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">Email</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">Telefone</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; text-align: right; width: 150px;">Opções</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof clientes !== "undefined" && clientes.length > 0) { %>
                    <% clientes.forEach(mostrar => { %> 
                        <tr class="linha-tabela" style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-family: monospace; color: #64748b; font-weight: 500;">
                                #<%= mostrar.id %>
                            </td>
                            <td style="padding: 1rem 1.5rem; font-weight: 600; color: #0f172a;">
                                <%= mostrar.nome %>
                            </td>
                            <td style="padding: 1rem 1.5rem; color: #475569;">
                                <%= mostrar.email %>
                            </td>
                            <td style="padding: 1rem 1.5rem; color: #475569;">
                                <%= mostrar.telephone %>
                            </td>
                            <td style="padding: 1rem 1.5rem; text-align: right;">
                                <div style="display: flex; justify-content: flex-end; gap: 10px; align-items: center;">
                                    <!-- Seus botões e emojis originais mantidos sem alterações visuais -->
                                    <a href="/clientes/editar/<%= mostrar.id %>" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background-color: #eff6ff; text-decoration: none; font-size: 1rem;" title="Editar Cliente">
                                        ✏️
                                    </a>
                                    <a href="/clientes/excluir/<%= mostrar.id %>" onclick="return confirm('Deseja excluir este Cliente?')" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background-color: #fef2f2; color: #dc2626; text-decoration: none; font-size: 1rem;" title="Excluir Cliente">
                                        🗑️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="padding: 2rem; text-align: center; color: #64748b;">
                            Nenhum cliente cadastrado.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include("../partials/footer") %>
