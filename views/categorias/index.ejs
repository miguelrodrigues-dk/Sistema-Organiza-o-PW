<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<style>
    /* Suas regras CSS originais mantidas */
    .linha-tabela:nth-child(even) {
        background-color: #f8fafc !important;
    }
    .linha-tabela:nth-child(odd) {
        background-color: #ffffff !important;
    }

    /* Adicionado isolamento de responsividade por classes para NÃO misturar ou alterar estilos inline */
    .cabecalho-listagem {
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 2rem; 
        border-bottom: 1px solid #f1f5f9; 
        padding-bottom: 1.5rem;
    }

    .container-responsivo-tabela {
        background-color: #ffffff; 
        border: 1px solid #e2e8f0; 
        border-radius: 16px; 
        padding: 2rem; 
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); 
        max-width: 1100px; 
        margin: 0 auto;
        box-sizing: border-box;
        width: 100%;
    }

    /* Regras de quebra de tela apenas para o celular */
    @media (max-width: 640px) {
        .container-responsivo-tabela {
            padding: 1rem; /* Reduz o espaçamento interno interno para ganhar tela no celular */
        }
        
        .cabecalho-listagem {
            flex-direction: column; /* Empilha o título e o botão verticalmente */
            align-items: flex-start; /* Alinha os elementos à esquerda */
            gap: 1rem; /* Dá um espaço confortável entre o subtítulo e o botão */
        }

        .cabecalho-listagem a {
            width: 100%; /* Faz o botão ocupar toda a largura no celular, facilitando o clique */
            justify-content: center;
            box-sizing: border-box;
        }
    }
</style>

<div class="container-responsivo-tabela">
    
    <!-- Cabecalho da Listagem Adaptável -->
    <div class="cabecalho-listagem">
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; letter-spacing: -0.025em;">Categorias Cadastradas</h2>
            <p style="font-size: 0.875rem; color: #64748b; margin: 5px 0 0 0;">Gerencie as divisões e classificações de produtos do sistema.</p>
        </div>
        <a href="/categorias/cadastro" style="display: inline-flex; align-items: center; gap: 8px; background-color: #4f46e5; color: #ffffff; text-decoration: none; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);">
            ➕ Adicionar Categoria
        </a>
    </div>

    <!-- Tabela Estruturada com Rolagem segura mantida -->
    <div style="width: 100%; overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 12px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; min-width: 600px;">
            <thead>
                <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; width: 100px;">ID</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; width: 250px;">Nome da Categoria</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">Descrição</th>
                    <th style="padding: 1rem 1.5rem; font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; text-align: right; width: 150px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof categorias !== "undefined" && categorias.length > 0) { %>
                    <% categorias.forEach((item) => { %> 
                        <tr class="linha-tabela" style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-family: monospace; color: #64748b; font-weight: 500;">
                                #<%= item.id %>
                            </td>
                            <td style="padding: 1rem 1.5rem; font-weight: 600; color: #0f172a;">
                                <%= item.nome %>
                            </td>
                            <td style="padding: 1rem 1.5rem; color: #475569; font-weight: 400; max-width: 400px; word-break: break-word;">
                                <%= item.descricao || "Sem descrição informada" %>
                            </td>
                            <td style="padding: 1rem 1.5rem; text-align: right;">
                                <div style="display: flex; justify-content: flex-end; gap: 10px; align-items: center;">
                                    <!-- Botao Editar original mantido -->
                                    <a href="/categorias/editar/<%= item.id %>" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background-color: #eff6ff; text-decoration: none; font-size: 1rem;" title="Editar Categoria">
                                        ✏️
                                    </a>
                                    <!-- Botao Excluir original mantido -->
                                    <a href="/categorias/excluir/<%= item.id %>" onclick="return confirm('Tem certeza que deseja excluir esta categoria?')" style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background-color: #fef2f2; color: #dc2626; text-decoration: none; font-size: 1rem;" title="Excluir Categoria">
                                        🗑️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="padding: 2rem; text-align: center; color: #64748b;">
                            Nenhuma categoria cadastrada.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include("../partials/footer") %>
